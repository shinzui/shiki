packages:
  shiki-core
  shiki-cli

-- The Kubernetes API code and handwritten client (`kubernetes-api` 134.0.1 and
-- `kubernetes-api-client` from Hackage) still explicitly derive Typeable. GHC
-- 9.12 auto-derives Typeable; pass the suppression as a compiler program option
-- so it lands after the dependency's own -Wall.
program-options
  ghc-options: -Wno-deriving-typeable

-- The Hackage `claude` library (pulled in by baikai-claude) caps
-- http-client-tls < 0.4 as of claude 1.5.0 but builds fine against 0.4.
allow-newer:
  claude:http-client-tls

-- GHC is provided by the Nix devShell from `nix-haskell-flake` (currently
-- pinned to ghc9124). Add a `with-compiler:` line here if you want
-- cabal to fail loudly when the version drifts from the flake.
test-show-details: direct
tests: True
-- Parallel module compilation
jobs: $ncpus
