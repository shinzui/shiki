{- Project-local shiki configuration.

   Declares the shiki environments available in this checkout and which one
   is the default. `shiki config show` prints the resolved configuration;
   `shiki run --env <name> ...` records runs into the named environment's
   database.

   Connection strings may be inlined as shown, or sourced from OS environment
   variables using Dhall's native import, e.g.:
     databaseUrl = env:SHIKI_STAGING_DATABASE_URL as Text
-}
let Schema =
      https://raw.githubusercontent.com/shinzui/shiki/master/schema/package.dhall

let mkEnv =
      \(url : Text) ->
      \(context : Optional Text) ->
        { databaseUrl = url, kubernetesContext = context } : Schema.EnvironmentWithContext

in    { environments =
          toMap
            { staging = mkEnv "postgresql://shiki:changeme@db.staging.internal:5432/shiki" (None Text)
            , prod = mkEnv "postgresql://shiki:changeme@db.prod.internal:5432/shiki" (Some "sennari")
            }
      , defaultEnvironment = "staging"
      }
    : Schema.ProjectConfigWithContext
