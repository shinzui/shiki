cabal-version: 3.4
name: shiki-cli
version: 0.1.0.0
synopsis: Command-line interface for shiki
description:
  Shiki is a CLI for conducting operational commands across Kubernetes services with a durable execution history. It helps operators run service-specific commands against the right cluster and environment, while recording each run in PostgreSQL with metadata such as the service, command, status, timing, and duration. The goal is to make ad hoc operational work safer, easier to audit, and easier to understand after the fact.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files: ../CHANGELOG.md
-- Embedded at compile time by Template Haskell; listing them here makes
-- cabal rebuild the embedding modules when they change.
extra-source-files:
  data/help/*.md
  data/prompts/*.md

data-files:
  data/help/*.md
  data/prompts/*.md

common common
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shiki.Cli
    Shiki.Cli.Agent
    Shiki.Cli.Agent.Config
    Shiki.Cli.Agent.Context
    Shiki.Cli.Agent.Launch
    Shiki.Cli.Agent.Prompt
    Shiki.Cli.Agent.Provider
    Shiki.Cli.Completions
    Shiki.Cli.Config
    Shiki.Cli.ConfigInit
    Shiki.Cli.ConfigShow
    Shiki.Cli.Env
    Shiki.Cli.Fzf
    Shiki.Cli.Fzf.Selector.Run
    Shiki.Cli.Fzf.Selector.Service
    Shiki.Cli.Help
    Shiki.Cli.Project
    Shiki.Cli.Run
    Shiki.Cli.Runs
    Shiki.Cli.Runs.Format
    Shiki.Cli.Runs.Sync
    Shiki.Cli.Schema
    Shiki.Cli.Version

  autogen-modules: Paths_shiki_cli
  other-modules: Paths_shiki_cli
  build-depends:
    aeson ^>=2.2,
    aeson-pretty ^>=0.8,
    baikai ^>=0.7,
    baikai-claude ^>=0.7,
    baikai-openai ^>=0.7,
    base >=4.21 && <5,
    bytestring ^>=0.12,
    containers ^>=0.7,
    directory ^>=1.3,
    file-embed ^>=0.0.16,
    filepath ^>=1.5,
    generic-lens >=2.2 && <2.4,
    githash ^>=0.1,
    hasql >=1.10,
    hasql-pool >=1.4,
    lens ^>=5.3,
    optparse-applicative >=0.19 && <0.20,
    process ^>=1.6,
    shiki-core,
    terminal-size >=0.3.4 && <0.4,
    text ^>=2.1,
    time ^>=1.14,
    vector,

executable shiki
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.21 && <5,
    shiki-cli,

test-suite shiki-cli-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  other-modules:
    Shiki.Cli.Agent.ContextSpec
    Shiki.Cli.Agent.LaunchSpec
    Shiki.Cli.Agent.PromptSpec
    Shiki.Cli.Agent.ProviderSpec
    Shiki.Cli.ConfigInitSpec
    Shiki.Cli.EnvRoutingSpec
    Shiki.Cli.Fixtures
    Shiki.Cli.Fzf.Selector.RunSpec
    Shiki.Cli.Fzf.Selector.ServiceSpec
    Shiki.Cli.FzfSpec
    Shiki.Cli.HelpSpec
    Shiki.Cli.ParserSpec
    Shiki.Cli.ProjectSpec
    Shiki.Cli.Runs.FormatSpec
    Shiki.Cli.Runs.SyncSpec
    Shiki.Cli.VersionSpec

  build-depends:
    aeson ^>=2.2,
    base >=4.21 && <5,
    containers ^>=0.7,
    directory ^>=1.3,
    ephemeral-pg >=0.2,
    filepath ^>=1.5,
    generic-lens >=2.2 && <2.4,
    hasql >=1.10,
    hasql-pool >=1.4,
    optparse-applicative >=0.19 && <0.20,
    shiki-cli,
    shiki-core,
    tasty >=1.5.4 && <1.6,
    tasty-hunit ^>=0.10,
    temporary >=1.3,
    text ^>=2.1,
    time ^>=1.14,
    uuid ^>=1.3,
