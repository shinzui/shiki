cabal-version: 3.4
name: shiki-cli
version: 0.1.0.0
synopsis: Command-line interface for shiki
description:
  Shiki is a CLI for conducting operational commands across Kubernetes services with a durable execution history. It helps operators run service-specific commands against the right cluster and environment, while recording each run in PostgreSQL with metadata such as the service, command, status, timing, and duration. The goal is to make ad hoc operational work safer, easier to audit, and easier to understand after the fact.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
extra-doc-files: ../CHANGELOG.md

data-files:
  data/prompts/*.md
  data/help/*.md

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings
    PackageImports

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Shiki.Cli
    Shiki.Cli.Agent
    Shiki.Cli.Agent.Config
    Shiki.Cli.Agent.Context
    Shiki.Cli.Agent.Launch
    Shiki.Cli.Agent.Prompt
    Shiki.Cli.Agent.Provider
    Shiki.Cli.Config
    Shiki.Cli.Env
    Shiki.Cli.Fzf
    Shiki.Cli.Fzf.Selector.Run
    Shiki.Cli.Help
    Shiki.Cli.Run
    Shiki.Cli.Runs
    Shiki.Cli.Schema

  build-depends:
    base >=4.20 && <5,
    shiki-core,
    aeson ^>=2.2,
    aeson-pretty ^>=0.8,
    baikai,
    baikai-claude,
    baikai-openai,
    bytestring ^>=0.12,
    containers ^>=0.7,
    directory ^>=1.3,
    file-embed ^>=0.0.16,
    filepath ^>=1.5,
    generic-lens,
    hasql >=1.10,
    hasql-pool >=1.4,
    lens ^>=5.3,
    optparse-applicative >=0.18,
    process ^>=1.6,
    text ^>=2.1,
    time ^>=1.12,
    vector,

executable shiki
  import: common-options
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.20 && <5,
    shiki-cli,

test-suite shiki-cli-test
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  other-modules:
    Shiki.Cli.Agent.ContextSpec
    Shiki.Cli.Agent.LaunchSpec
    Shiki.Cli.Agent.PromptSpec
    Shiki.Cli.Agent.ProviderSpec
    Shiki.Cli.Fzf.Selector.RunSpec
    Shiki.Cli.HelpSpec

  build-depends:
    base >=4.20 && <5,
    aeson ^>=2.2,
    directory ^>=1.3,
    ephemeral-pg >=0.2,
    filepath ^>=1.5,
    hasql >=1.10,
    hasql-pool >=1.4,
    optparse-applicative >=0.18,
    shiki-cli,
    shiki-core,
    tasty ^>=1.5,
    tasty-hunit ^>=0.10,
    temporary >=1.3,
    text ^>=2.1,
    time ^>=1.12,
    uuid ^>=1.3,
