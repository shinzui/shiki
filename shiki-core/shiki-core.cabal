cabal-version: 3.4
name: shiki-core
version: 0.1.0.0
synopsis:
  shiki conducts operational commands across Kubernetes services and records what ran, where it ran, and how long it took.

description:
  Shiki is a CLI for conducting operational commands across Kubernetes services with a durable execution history. It helps operators run service-specific commands against the right cluster and environment, while recording each run in PostgreSQL with metadata such as the service, command, status, timing, and duration. The goal is to make ad hoc operational work safer, easier to audit, and easier to understand after the fact.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files: ../CHANGELOG.md
extra-source-files:
  ../schema/*.dhall
  dhall/*.dhall
  sql/migrations/*.sql
  sql/migrations/manifest

data-files:
  ../schema/*.dhall
  dhall/*.dhall
  sql/migrations/*.sql

common common
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shiki.Analysis.Backend
    Shiki.Analysis.Baikai
    Shiki.Analysis.Heuristic
    Shiki.Effect.Analyzer
    Shiki.Effect.ConfigLoader
    Shiki.Effect.Kube
    Shiki.Effect.Kube.Client
    Shiki.Effect.RunStore
    Shiki.Effect.RunStore.Postgres
    Shiki.Error
    Shiki.K8s.Client
    Shiki.K8s.ExecCredential
    Shiki.K8s.Introspection
    Shiki.K8s.JobBuilder
    Shiki.K8s.Logs
    Shiki.K8s.Runner
    Shiki.Persistence.Connection
    Shiki.Persistence.Migration
    Shiki.Persistence.Run
    Shiki.Persistence.RunStatus
    Shiki.Persistence.Schema
    Shiki.Prelude
    Shiki.Project.Config
    Shiki.Project.Config.Dhall
    Shiki.Service.Config
    Shiki.Service.Config.Dhall

  other-modules: Paths_shiki_core
  autogen-modules: Paths_shiki_core
  build-depends:
    aeson ^>=2.2,
    baikai ^>=0.7,
    baikai-claude ^>=0.7,
    baikai-effectful ^>=0.4.0.2,
    baikai-openai ^>=0.7,
    base >=4.21 && <5,
    bytestring ^>=0.12,
    containers ^>=0.7,
    dhall ^>=1.42,
    directory ^>=1.3,
    effectful ^>=2.7.1.0,
    effectful-core ^>=2.7.1.1,
    filepath ^>=1.5,
    generic-lens >=2.2 && <2.4,
    hasql >=1.10,
    hasql-pool >=1.4,
    http-client >=0.7,
    http-client-tls,
    http-types >=0.12 && <0.13,
    kubernetes-api ==134.*,
    kubernetes-api-client,
    lens ^>=5.3,
    mtl ^>=2.3,
    pg-migrate ^>=1.1,
    pg-migrate-embed ^>=1.1,
    pg-migrate-import-hasql-migration ^>=1.1,
    process ^>=1.6,
    random ^>=1.2,
    stm ^>=2.5,
    text ^>=2.1,
    time ^>=1.14,
    uuid ^>=1.3,
    vector,
    yaml ^>=0.11,

executable shiki-run-once
  import: common
  main-is: RunOnce.hs
  hs-source-dirs: example
  build-depends:
    base >=4.21 && <5,
    generic-lens >=2.2 && <2.4,
    shiki-core,
    text ^>=2.1,

test-suite shiki-core-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  other-modules:
    Shiki.Analysis.HeuristicSpec
    Shiki.Effect.AnalyzerSpec
    Shiki.Effect.RunStoreSpec
    Shiki.EffectfulContractSpec
    Shiki.K8s.ClassifyJobSpec
    Shiki.K8s.CredentialExpirySpec
    Shiki.K8s.ExecCredentialSpec
    Shiki.K8s.JobBuilderSpec
    Shiki.Persistence.ErrorSummaryColumnSpec
    Shiki.Persistence.LastWatchedAtSpec
    Shiki.Persistence.MigrationSpec
    Shiki.Persistence.RestrictedRoleSpec
    Shiki.Persistence.RunListSpec
    Shiki.Persistence.RunSpec
    Shiki.Persistence.SchemaIsolationSpec
    Shiki.Persistence.SchemaSpec
    Shiki.Persistence.TestPg
    Shiki.Project.ConfigSpec
    Shiki.Service.ConfigSpec

  build-depends:
    aeson ^>=2.2,
    baikai ^>=0.7,
    baikai-effectful ^>=0.4.0.2,
    base >=4.21 && <5,
    containers ^>=0.7,
    directory ^>=1.3,
    effectful ^>=2.7.1.0,
    effectful-core ^>=2.7.1.1,
    ephemeral-pg >=0.2,
    filepath ^>=1.5,
    generic-lens >=2.2 && <2.4,
    hasql >=1.10,
    hasql-pool >=1.4,
    kubernetes-api ==134.*,
    pg-migrate ^>=1.1,
    shiki-core,
    tasty ^>=1.5,
    tasty-hunit ^>=0.10,
    temporary >=1.3,
    text ^>=2.1,
    time ^>=1.14,
    uuid ^>=1.3,
    vector,
