cabal-version:      3.4
name:               shiki-core
version:            0.1.0.0
synopsis:
  shiki conducts operational commands across Kubernetes services and records what ran, where it ran, and how long it took.

description:
  Shiki is a CLI for conducting operational commands across Kubernetes services with a durable execution history. It helps operators run service-specific commands against the right cluster and environment, while recording each run in PostgreSQL with metadata such as the service, command, status, timing, and duration. The goal is to make ad hoc operational work safer, easier to audit, and easier to understand after the fact.

license:            BSD-3-Clause
license-file:       ../LICENSE
author:             Nadeem Bitar
maintainer:         nadeem@gmail.com
copyright:          (c) 2026 Nadeem Bitar
build-type:         Simple
extra-doc-files:    ../CHANGELOG.md
extra-source-files: sql/migrations/*.sql
data-files:         sql/migrations/*.sql

common common-options
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wredundant-constraints
    -fhide-source-paths -Wmissing-export-lists -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings
    PackageImports

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules:
    Shiki.Analysis.Backend
    Shiki.Analysis.Baikai
    Shiki.Analysis.Heuristic
    Shiki.K8s.Client
    Shiki.K8s.Introspection
    Shiki.K8s.JobBuilder
    Shiki.K8s.Logs
    Shiki.K8s.Runner
    Shiki.Persistence.Connection
    Shiki.Persistence.Migration
    Shiki.Persistence.Run
    Shiki.Persistence.RunStatus
    Shiki.Persistence.Schema
    Shiki.Prelude
    Shiki.Service.Config
    Shiki.Service.Config.Dhall

  other-modules:   Paths_shiki_core
  autogen-modules: Paths_shiki_core
  build-depends:
    , aeson                  ^>=2.2
    , baikai
    , baikai-claude
    , baikai-openai
    , base                   >=4.20  && <5
    , bytestring             ^>=0.12
    , containers             ^>=0.7
    , dhall                  ^>=1.42
    , directory              ^>=1.3
    , filepath               ^>=1.5
    , generic-lens
    , hasql                  >=1.10
    , hasql-migration        >=0.3
    , hasql-pool             >=1.4
    , hasql-transaction      >=1.2
    , http-client            >=0.7
    , http-client-tls
    , kubernetes-api
    , kubernetes-api-client
    , lens                   ^>=5.3
    , mtl                    ^>=2.3
    , random                 ^>=1.2
    , stm                    ^>=2.5
    , text                   ^>=2.1
    , time                   ^>=1.12
    , uuid                   ^>=1.3
    , vector

executable shiki-run-once
  import:         common-options
  main-is:        RunOnce.hs
  hs-source-dirs: example
  build-depends:
    , base        >=4.20 && <5
    , shiki-core
    , text        ^>=2.1

test-suite shiki-core-test
  import:         common-options
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: test
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  other-modules:
    Shiki.Analysis.BackendSpec
    Shiki.Analysis.HeuristicSpec
    Shiki.K8s.JobBuilderSpec
    Shiki.Persistence.ErrorSummaryColumnSpec
    Shiki.Persistence.RunListSpec
    Shiki.Persistence.RunSpec
    Shiki.Persistence.SchemaIsolationSpec
    Shiki.Persistence.SchemaSpec
    Shiki.Persistence.TestPg
    Shiki.Service.ConfigSpec

  build-depends:
    , aeson           ^>=2.2
    , base            >=4.20  && <5
    , containers      ^>=0.7
    , directory       ^>=1.3
    , ephemeral-pg    >=0.2
    , filepath        ^>=1.5
    , hasql           >=1.10
    , hasql-pool      >=1.4
    , kubernetes-api
    , shiki-core
    , tasty           ^>=1.5
    , tasty-hunit     ^>=0.10
    , text            ^>=2.1
    , time            ^>=1.12
    , uuid            ^>=1.3
